# Copy to .env.local for local work. Set the same names in Vercel.

# The public address of the site, no trailing slash. Links in emails and the
# calendar feed are built from it.
NEXT_PUBLIC_SITE_URL=https://nonprofitsinaction.org

# Supabase project settings (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Email to submitters and admins, through Mailgun (the same account pear-portal
# uses is fine). Without these, emails are printed to the server log instead,
# which is what you want locally. In production they are required.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# https://api.eu.mailgun.net for an EU domain.
MAILGUN_API_BASE=https://api.mailgun.net
EMAIL_FROM=Nonprofits in Action <calendar@nonprofitsinaction.org>

# Optional: a Slack incoming webhook that hears about every new listing and
# every change an organizer makes to a live one.
SLACK_WEBHOOK_URL=

# Cloudflare Turnstile (free) on the public forms. Without both, the forms
# rely on the honeypot field and the minimum fill time alone.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# `next dev` only: open /admin as this address without a magic link, for
# working against a local database with no auth server. Ignored by every
# build, previews included.
LOCAL_ADMIN_EMAIL=
